{
  "name": "@roi-dealer/bot",
  "version": "0.0.0",
  "private": true,
  "description": "ROI Dealer owner bot: Telegram control panel (approvals, kill switch, journal, digest)",
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "dev": "tsx watch --conditions=@roi-dealer/source --env-file-if-exists=../../.env src/main.ts",
    "start": "node --enable-source-maps dist/main.js"
  },
  "dependencies": {
    "@roi-dealer/command-center": "workspace:*",
    "@roi-dealer/database": "workspace:*",
    "@roi-dealer/observability": "workspace:*",
    "@roi-dealer/shared": "workspace:*",
    "@roi-dealer/telegram": "workspace:*",
    "zod": "^4.6.5"
  }
}
