# ROI Dealer — local development environment template.
#
# Copy to `.env` for local development: `cp .env.example .env`
# `.env` is git-ignored. NEVER put real secrets in this file or in the repository.
# Production secrets are provided by a managed Secret Manager / Vault, not by .env files.

# Runtime environment: development | test | production
NODE_ENV=development

# Minimum log level: debug | info | warn | error | fatal
LOG_LEVEL=info

# API bind address and port. Use 0.0.0.0 only inside a container.
API_HOST=127.0.0.1
API_PORT=3000

# Worker liveness heartbeat (ms)
WORKER_HEARTBEAT_INTERVAL_MS=60000

# Local PostgreSQL from infra/docker/compose.yaml (dev-only, non-production credentials).
# Not read by any service until PHASE 02 — PostgreSQL Foundation.
DATABASE_URL=postgresql://roi_dealer:roi_dealer_dev_only@localhost:5432/roi_dealer_dev
