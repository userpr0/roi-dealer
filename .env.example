# ROI Dealer — local development environment template.
#
# Copy to `.env` for local development: `cp .env.example .env`
# `.env` is git-ignored. NEVER put real secrets in this file or in the repository.
# Production secrets are provided by a managed Secret Manager / Vault, not by .env files.

# Runtime environment: development | test | production
NODE_ENV=development

# Minimum log level: debug | info | warn | error | fatal
LOG_LEVEL=info

# API bind address and port. Use 0.0.0.0 only inside a container.
API_HOST=127.0.0.1
API_PORT=3000

# Worker liveness heartbeat (ms)
WORKER_HEARTBEAT_INTERVAL_MS=60000

# Telegram owner bot (apps/bot). Needed only for `pnpm dev:bot`.
# Use a SEPARATE test bot locally: one token must not be polled by two running bots.
# The token is a secret — keep it only in your local .env, never commit it.
TELEGRAM_BOT_TOKEN=
# Your numeric Telegram user id (ask @userinfobot). The bot answers only this user.
TELEGRAM_OWNER_USER_ID=

# Local PostgreSQL from infra/docker/compose.yaml (dev-only, non-production credentials).
# Used by `pnpm db:migrate`; when set, the api reports it in GET /health and the bot enables
# the command center (/decisions, /stop, /journal, /digest). Apply migrations first.
DATABASE_URL=postgresql://roi_dealer:roi_dealer_dev_only@localhost:5432/roi_dealer_dev
# Optional pool settings (defaults: 5 connections, 10 s connect timeout).
DATABASE_POOL_MAX=
DATABASE_CONNECT_TIMEOUT_SECONDS=

# Integration tests create throwaway databases on this server (default: the local one above).
TEST_DATABASE_URL=
